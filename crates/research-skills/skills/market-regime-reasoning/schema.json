{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MarketRegimeAnalysis",
  "type": "object",
  "required": ["regime_state", "confidence", "transition_detected", "key_drivers", "risk_assessment"],
  "properties": {
    "regime_state": {
      "type": "string",
      "enum": ["risk_on", "neutral", "risk_off", "de_risk"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "transition_detected": {
      "type": "boolean"
    },
    "previous_state": {
      "type": "string",
      "enum": ["risk_on", "neutral", "risk_off", "de_risk"]
    },
    "key_drivers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_assessment": {
      "type": "object",
      "required": ["level", "factors", "recommendation"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "factors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommendation": {
          "type": "string",
          "enum": ["maintain", "reduce_exposure", "increase_quality", "hedge", "exit"]
        }
      }
    },
    "reasoning_trace": {
      "type": "object"
    }
  }
}
