{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VolatilityTailRiskAnalysis",
  "type": "object",
  "required": ["volatility_regime", "tail_risk_level", "vix_analysis", "tail_analysis", "recommendation", "confidence"],
  "properties": {
    "volatility_regime": {
      "type": "string",
      "enum": ["low", "normal", "high", "extreme"]
    },
    "tail_risk_level": {
      "type": "string",
      "enum": ["low", "moderate", "elevated", "severe"]
    },
    "vix_analysis": {
      "type": "object",
      "required": ["current_vix", "regime", "signal"],
      "properties": {
        "current_vix": {
          "type": "number",
          "minimum": 0
        },
        "regime": {
          "type": "string",
          "enum": ["low", "normal", "high", "extreme"]
        },
        "signal": {
          "type": "string",
          "enum": ["low_volatility", "normal_volatility", "elevated_volatility", "extreme_volatility"]
        },
        "percentile_rank": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "tail_analysis": {
      "type": "object",
      "required": ["skewness", "kurtosis", "tail_risk_level", "signal"],
      "properties": {
        "skewness": {
          "type": "number"
        },
        "kurtosis": {
          "type": "number",
          "minimum": 0
        },
        "tail_index": {
          "type": "number",
          "minimum": 0
        },
        "tail_risk_level": {
          "type": "string",
          "enum": ["low", "moderate", "elevated", "severe"]
        },
        "signal": {
          "type": "string",
          "enum": ["no_tail_risk", "fat_tail_neutral", "fat_tail_negative_skew", "severe_tail_risk"]
        }
      }
    },
    "recommendation": {
      "type": "string",
      "enum": ["maintain", "monitor", "reduce_exposure", "hedge", "exit"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoning_trace": {
      "type": "object"
    }
  }
}
