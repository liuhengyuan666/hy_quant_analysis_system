{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LiquidityShockAnalysis",
  "type": "object",
  "required": ["liquidity_state", "shock_detected", "funding_stress", "recommendation", "severity", "confidence"],
  "properties": {
    "liquidity_state": {
      "type": "string",
      "enum": ["normal", "warning", "shock_active", "shock_critical"]
    },
    "shock_detected": {
      "type": "boolean"
    },
    "funding_stress": {
      "type": "string",
      "enum": ["low", "moderate", "high", "critical"]
    },
    "recommendation": {
      "type": "string",
      "enum": ["maintain", "reduce_marginal_exposure", "reduce_exposure", "defensive"]
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "funding_signal": {
      "type": "string",
      "enum": ["normal", "elevated", "stressed", "critical"],
      "description": "Optional direct funding signal label"
    },
    "breadth_confirmed": {
      "type": "boolean",
      "description": "Whether breadth deterioration confirms funding stress"
    },
    "breadth_severity": {
      "type": "string",
      "enum": ["none", "moderate", "high", "extreme"],
      "description": "Optional breadth severity classification"
    },
    "reasoning_trace": {
      "type": "object",
      "properties": {
        "funding_analysis": {
          "type": "object",
          "properties": {
            "input": { "type": "string" },
            "funding_state": { "type": "string", "enum": ["stressed", "moderating", "benign"] },
            "funding_signal": { "type": "string", "enum": ["normal", "elevated", "stressed", "critical"] },
            "conclusion": { "type": "string" }
          }
        },
        "breadth_confirmation": {
          "type": "object",
          "properties": {
            "input": { "type": "string" },
            "breadth_confirmed": { "type": "boolean" },
            "breadth_severity": { "type": "string", "enum": ["none", "moderate", "high", "extreme"] },
            "conclusion": { "type": "string" }
          }
        },
        "shock_detection": {
          "type": "object",
          "properties": {
            "from": { "type": "string" },
            "to": { "type": "string" },
            "condition": { "type": "string" },
            "conclusion": { "type": "string" }
          }
        }
      }
    }
  }
}
