{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SectorRotationAnalysis",
  "type": "object",
  "required": ["rotation_detected", "rotation_type", "leading_sectors", "lagging_sectors", "factor_analysis", "recommendation", "confidence"],
  "properties": {
    "rotation_detected": {
      "type": "boolean"
    },
    "rotation_type": {
      "type": "string",
      "enum": ["momentum_rotation", "value_rotation", "quality_rotation", "defensive_rotation", "no_rotation"]
    },
    "leading_sectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sector", "score"],
        "properties": {
          "sector": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "lagging_sectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sector", "score"],
        "properties": {
          "sector": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "factor_analysis": {
      "type": "object",
      "required": ["dominant_style", "momentum_strength", "value_alignment", "quality_alignment", "crowding_alert"],
      "properties": {
        "dominant_style": {
          "type": "string",
          "enum": ["momentum", "value", "quality", "defensive", "none"]
        },
        "momentum_strength": {
          "type": "string",
          "enum": ["strong", "moderate", "weak", "neutral"]
        },
        "value_alignment": {
          "type": "string",
          "enum": ["strong", "moderate", "weak", "neutral"]
        },
        "quality_alignment": {
          "type": "string",
          "enum": ["strong", "moderate", "weak", "neutral"]
        },
        "crowding_alert": {
          "type": "boolean"
        }
      }
    },
    "recommendation": {
      "type": "object",
      "required": ["action", "target_sectors", "avoid_sectors", "rationale"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["rotate_into", "rotate_out_of", "hold", "diversify", "reduce_exposure"]
        },
        "target_sectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoid_sectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoning_trace": {
      "type": "object"
    }
  }
}
