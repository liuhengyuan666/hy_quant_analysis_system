{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MacroLinkageAnalysis",
  "type": "object",
  "required": ["linkage_signal", "spread_analysis", "dxy_analysis", "flow_analysis", "recommendation", "confidence"],
  "properties": {
    "linkage_signal": {
      "type": "string",
      "enum": ["inflow_aligned", "outflow_aligned", "mixed_divergent", "insufficient_data"]
    },
    "spread_analysis": {
      "type": "object",
      "required": ["spread_signal", "spread_value", "assessment"],
      "properties": {
        "spread_signal": {
          "type": "string",
          "enum": ["widening", "narrowing", "stable"]
        },
        "spread_value": {
          "type": "number"
        },
        "assessment": {
          "type": "string"
        }
      }
    },
    "dxy_analysis": {
      "type": "object",
      "required": ["dxy_signal", "dxy_value", "assessment"],
      "properties": {
        "dxy_signal": {
          "type": "string",
          "enum": ["strengthening", "weakening", "stable"]
        },
        "dxy_value": {
          "type": "number"
        },
        "assessment": {
          "type": "string"
        }
      }
    },
    "flow_analysis": {
      "type": "object",
      "required": ["flow_signal", "flow_value", "assessment"],
      "properties": {
        "flow_signal": {
          "type": "string",
          "enum": ["positive", "negative", "neutral"]
        },
        "flow_value": {
          "type": "number"
        },
        "supporting_factors": {
          "type": "object",
          "properties": {
            "vix_signal": {
              "type": "string",
              "enum": ["elevated", "moderate", "low"]
            },
            "vix_value": {
              "type": "number"
            }
          }
        },
        "assessment": {
          "type": "string"
        }
      }
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "favorable_external",
        "unfavorable_external",
        "neutral_external",
        "data_stale",
        "insufficient_data"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoning_trace": {
      "type": "object"
    }
  }
}
