# LLM 配置示例文件
# 复制为 config/llm.toml 并填入实际值
#
# 加载优先级：CLI 参数 > 本文件（含环境变量插值） > 默认值
#
# 安全建议：
#   - API Key 使用环境变量引用 ${VAR_NAME}，不要直接写入
#   - config/llm.toml 已在 .gitignore 中排除，不会提交到版本控制

[llm]
# LLM API 基础 URL
# 支持 OpenAI、DeepSeek、本地模型等 OpenAI-compatible API
base_url = "https://api.openai.com/v1"

# 模型名称
model = "gpt-4o-mini"

# 请求超时时间（秒）
timeout_secs = 60

[llm.auth]
# API Key 配置（三选一，按优先级）：
#
# 方式1: 环境变量引用（推荐，最安全）
#   api_key = "${OPENAI_API_KEY}"
#
# 方式2: 直接写入（不推荐，仅测试用）
#   api_key = "sk-xxxxxxxxxxxxxxxx"
#
# 方式3: 不设置此项，通过 CLI 命令设置到 Keyring
#   api_key = ""
#
# 环境变量插值语法：
#   ${VAR_NAME}   → 读取环境变量 VAR_NAME（仅支持完整值替换）
#   $${LITERAL}   → 转义为字面值 ${LITERAL}
#
# 注意：仅支持完整值替换，不支持嵌入式插值
#   ✅ api_key = "${OPENAI_API_KEY}"        # 正确
#   ❌ api_key = "Bearer ${TOKEN}"          # 不会插值
#   ✅ api_key = "${FULL_API_KEY_VALUE}"    # 环境变量中存储完整值
api_key = "${OPENAI_API_KEY}"

[llm.defaults]
# 默认 temperature（0.0-2.0）
# 较低值（0.0-0.3）：更确定性、更适合分析
# 较高值（0.7-1.0）：更创造性、更适合生成
temperature = 0.7

# 默认 max_tokens
max_tokens = 4096

# 可选：固定 seed 用于可复现分析
# seed = 42

# ============================================================
# 多环境配置示例
# ============================================================
#
# 创建 config/llm.dev.toml、config/llm.prod.toml 等文件
# 通过环境变量选择：
#   set LLM_CONFIG_PROFILE=dev    (Windows)
#   export LLM_CONFIG_PROFILE=dev (Linux/macOS)
#
# 优先级：llm.{profile}.toml > llm.toml > 默认值

# ============================================================
# 常用 LLM 提供商配置示例
# ============================================================

